{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ai-sales-engine-mocha.vercel.app/panel/api/:path*" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "https://ai-sales-engine-mocha.vercel.app/panel/api/.well-known/oauth-protected-resource/:path*" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "https://ai-sales-engine-mocha.vercel.app/panel/api/.well-known/oauth-authorization-server/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
