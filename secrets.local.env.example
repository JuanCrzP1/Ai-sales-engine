# Ejemplo sin valores reales de secrets.local.env, el archivo que lleva los secretos de un equipo a otro.
# El real está en .gitignore y nunca se sube a GitHub. Se genera con: python scripts/local_secrets.py export
# Instrucciones: docs/operations.md, «Trabajar Desde Windows Y macOS».

# --- Panel y BusinessConfig ---
# Clave Fernet que cifra los datos de pago. Si la base ya tiene datos, debe ser la misma con la que se cifraron:
# otra clave los dejaría ilegibles. Se conserva exacta, incluido el = final.
BUSINESS_CONFIG_SECRETS_KEY=

# --- Motor. `install` las copia a .env; el panel no las necesita ---
# Modelo de IA
LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_ADVANCED_MODEL=
# PostgreSQL del motor
DATABASE_URL=
# Telegram
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_ID=
# Negocio activo
TENANT_SLUG=
# Webhook de WhatsApp
META_VERIFY_TOKEN=
