# =====================================================================================================================
# Variables de AI Sales Engine: QUÉ va DÓNDE.
#
#   1. ESTE EQUIPO  → se copian a `.env` en la raíz del repositorio (o `project/.env`). Nunca se suben a GitHub.
#   2. VERCEL       → producción. Se escriben en Vercel → el proyecto → Settings → Environment Variables. NUNCA en un archivo
#                     de este equipo: los valores reales de producción solo viven en Vercel. Aquí aparecen comentadas, para
#                     saber cuáles hay.
#
# Los secretos de este equipo viajan a otro con `python scripts/local_secrets.py export` (ver docs/operations.md). La tabla
# completa, con lo que hace cada una: docs/operations.md, «Variables De Entorno». Una prueba (tests/test_env_example.py) falla si
# el código empieza a leer una variable que no está aquí.
# =====================================================================================================================


# ---------------------------------------------------------------------------------------------------------------------
# 1. ESTE EQUIPO (.env)
# ---------------------------------------------------------------------------------------------------------------------

# PostgreSQL de este equipo: tablas del motor (memoria de cada cliente).
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/db

# Almacén del panel. Vacío: archivo SQLite local en project/data/.
BUSINESS_CONFIG_DATABASE_URL=
# Clave Fernet que cifra los datos de pago y las claves de IA. Sin ella no se guardan ni se leen.
# La API del panel no lee este archivo: toma su clave de secrets.local.env o de .ai-sales-engine/ en la carpeta del usuario.
BUSINESS_CONFIG_SECRETS_KEY=

# IA. El motor NO usa una clave general: cada negocio guarda la suya en el panel. OPENROUTER_API_KEY solo la usan las
# pruebas en vivo (pytest -m integration).
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo para los negocios que no eligen uno.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_ADVANCED_MODEL=openai/gpt-4.1-mini
# Modelo económico que entiende fotos y notas de voz (opcional).
MEDIA_AI_MODEL=

# Solo para `scripts/setup_cloud_database.py`: la cadena de conexión de cada rama de Neon, tal como la da Neon.
CLOUD_DATABASE_URL_PRODUCTION=
CLOUD_DATABASE_URL_PRUEBAS=

# Webhook de WhatsApp de Meta (opcional; hoy se usa WhatsApp por código QR).
META_VERIFY_TOKEN=

# WhatsApp por código QR en este equipo (opcional). Vacías: Canales dice que la conexión todavía no está activa.
UAZAPI_BASE_URL=
UAZAPI_ADMIN_TOKEN=

# WhatsApp simulado (apps/wa-sim, solo en este equipo): con la dirección, el panel y el motor le hablan al simulador en vez de a
# uazapi. Solo http://localhost o http://127.0.0.1; se ignora en producción y en Vercel. El token por defecto es «simulador».
WHATSAPP_SIMULATOR_URL=
WHATSAPP_SIMULATOR_TOKEN=

# Las ponen solos los lanzadores (./run_local.sh, run_local.bat); no hace falta escribirlas:
#   ENGINE_PUBLIC_URL            la dirección de ngrok, para el webhook de WhatsApp
#   PANEL_URL                    el panel local (http://localhost:5180)
#   ATTENTION_SWEEP_ON_TRAFFIC   1: la IA retoma los chats que nadie atendió con el tráfico local


# ---------------------------------------------------------------------------------------------------------------------
# 2. VERCEL (producción). Comentadas a propósito: los valores reales solo están en Vercel.
# ---------------------------------------------------------------------------------------------------------------------

# Proyecto ai-sales-engine (el MOTOR), entorno Production:
# MODE=production
# DATABASE_URL=                     Neon, rama production, con pooling            (Sensitive)
# BUSINESS_CONFIG_DATABASE_URL=     la misma cadena                                (Sensitive)
# BUSINESS_CONFIG_SECRETS_KEY=      una clave Fernet propia de producción          (Sensitive; copia en secrets.production.env)
# NEON_AUTH_URL=                    Neon → la rama → Better Auth → Auth URL (es pública)
# UAZAPI_BASE_URL=                  el servidor de uazapi de la plataforma
# UAZAPI_ADMIN_TOKEN=               su token de administrador                       (Sensitive)
# LLM_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# RESEND_API_KEY=                   la clave de Resend para los correos de aviso    (Sensitive)
# CRON_SECRET=                      texto largo inventado (16+), protege la revisión cada 15 min (Sensitive)
# EMAIL_FROM=                       remitente con dominio verificado en Resend (sin él: onboarding@resend.dev)
# PANEL_URL=                        solo si el panel cambia de dirección (por defecto, ai-sales-engine-panel.vercel.app)
#
# Proyecto ai-sales-engine (el MOTOR), entorno Preview: DATABASE_URL, BUSINESS_CONFIG_DATABASE_URL y BUSINESS_CONFIG_SECRETS_KEY
# de la rama `pruebas` de Neon, y MODE=production.
#
# Proyecto ai-sales-engine-panel (el PANEL):
# VITE_NEON_AUTH_URL=               la misma dirección de NEON_AUTH_URL
#
# Las pone Vercel sola: VERCEL, VERCEL_PROJECT_PRODUCTION_URL.


# ---------------------------------------------------------------------------------------------------------------------
# 3. OPCIONALES (no hace falta escribirlas; están para casos puntuales)
# ---------------------------------------------------------------------------------------------------------------------
# ENABLE_FILE_LOGS=1            guarda los registros del motor también en archivo (solo en este equipo)
# ADMIN_API_PORT=8010           otro puerto para la API local del panel
# ADMIN_API_PYTHON=, ADMIN_API_ROOT=   los usa el panel al arrancar su API local en las pruebas de integración
# LLM_MODE=mock_fail            solo pruebas: simula que la IA falla
# OPENAI_API_KEY=               no se usa para responder; el diagnóstico de arranque solo dice si existe
# AI_SALES_ENGINE_SECRETS_FILE= otro archivo de secretos para la API local del panel (por defecto, secrets.local.env)
