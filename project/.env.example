OPENROUTER_API_KEY=your_key_here
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/db

# BusinessConfig: base del almacén de configuración. Vacío: archivo SQLite local en project/data/.
BUSINESS_CONFIG_DATABASE_URL=
# Clave Fernet que cifra los datos de pago del almacén. Sin ella no se guardan ni se leen.
# La API del panel no lee este archivo: toma su clave de secrets.local.env o de .ai-sales-engine/ en la carpeta del usuario.
BUSINESS_CONFIG_SECRETS_KEY=

# Fuente de configuración del motor, negocio por negocio. Vacío: todos con sus YAML (estado actual).
# Lista de slugs separada por comas, o "*" para todos.
BUSINESS_CONFIG_CONTRACT_TENANTS=
# De dónde lee el motor el contrato de esos negocios: "file" (business-config.json del negocio) o
# "database" (lo publicado desde el panel, en BUSINESS_CONFIG_DATABASE_URL con BUSINESS_CONFIG_SECRETS_KEY).
BUSINESS_CONFIG_STORE=file
