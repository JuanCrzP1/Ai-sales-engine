# Solo para las pruebas en vivo (pytest -m integration). El motor no la usa: cada negocio guarda su clave en el panel.
OPENROUTER_API_KEY=
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/db

# BusinessConfig: base del almacén de configuración. Vacío: archivo SQLite local en project/data/.
BUSINESS_CONFIG_DATABASE_URL=
# Clave Fernet que cifra los datos de pago del almacén. Sin ella no se guardan ni se leen.
# La API del panel no lee este archivo: toma su clave de secrets.local.env o de .ai-sales-engine/ en la carpeta del usuario.
BUSINESS_CONFIG_SECRETS_KEY=

# El motor responde siempre con lo publicado desde el panel, en BUSINESS_CONFIG_DATABASE_URL con BUSINESS_CONFIG_SECRETS_KEY.
# No hay otra fuente ni variables para elegirla.

# Solo para `scripts/setup_cloud_database.py`: la cadena de conexión de cada rama de Neon, tal como la da Neon.
CLOUD_DATABASE_URL_PRODUCTION=
CLOUD_DATABASE_URL_PRUEBAS=

# Panel en la nube: dirección de Neon Auth de la rama (Neon → Better Auth → Configure Auth → Auth URL). Vacía: el motor no publica la API del panel.
NEON_AUTH_URL=

# WhatsApp por código QR: el servidor de uazapi de la plataforma y su token de administrador (panel de uazapi). Son de la
# plataforma, no de cada negocio: con ellos se crea una instancia por negocio. En Vercel, el token va como *Sensitive*.
# Vacías: Canales dice que la conexión por código QR todavía no está activa.
UAZAPI_BASE_URL=
UAZAPI_ADMIN_TOKEN=

# Dirección pública del motor para el webhook de WhatsApp. En Vercel se deduce (VERCEL_PROJECT_PRODUCTION_URL); en este equipo
# la pone ./run_local.sh con la de ngrok.
ENGINE_PUBLIC_URL=
