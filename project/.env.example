APP_NAME=Asistente Virtual AI para WhatsApp y CRM
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api/v1
DEBUG=true

# Base de datos
# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:tu_clave@localhost:5432/assistant_ai

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CONNECTOR_SECRETS_KEY=

# Proveedor LLM preferido
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_ADVANCED_MODEL=openai/gpt-4.1-mini
LLM_TIMEOUT_SECONDS=15
EMBEDDING_MODEL=text-embedding-3-small

# Credenciales globales de fallback.
# En una instalación multi-tenant profesional, las credenciales reales por cliente
# deben cargarse por API/DB en la tabla tenant_connector_configs.

# WhatsApp con Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# Meta / WhatsApp Cloud / Instagram
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_BUSINESS_ACCOUNT_ID=
META_IG_ACCOUNT_ID=
PUBLIC_BASE_URL=http://localhost:8000

SEED_DEFAULT_DATA=true
ENABLE_MULTI_TENANT=true
SEMANTIC_THRESHOLD=0.22
CONVERSATION_CONTEXT_LIMIT=8
MAX_MESSAGE_LENGTH=2000
