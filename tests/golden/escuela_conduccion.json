        "explain_first": true,
        "sell_after": true
      }
    },
    "solution": {
      "framing": [
        "explicamos el proceso por pasos segun tipo de licencia",
        "validamos requisitos antes de agendar para evitar rechazos",
        "guiamos inscripcion y documentacion de forma progresiva"
      ],
      "process_steps": [
        "identificar tipo de licencia segun necesidad",
        "revisar requisitos y documentos",
        "registrar datos y agendar inicio",
        "iniciar curso y seguimiento de tramite"
      ],
      "requirements": [
        "documento de identidad vigente",
        "examen medico vigente",
        "datos de contacto activos"
      ]
    },
    "closing": {
      "strategy": "booking",
      "next_step": {
        "action": "dynamic"
      },
      "required_data": [
        "name",
        "phone",
        "license_type"
      ],
      "behavior": {
        "direct_sale": {
          "goal": "confirmar_compra"
        },
        "lead_capture": {
          "goal": "capturar_datos"
        },
        "booking": {
          "goal": "agendar"
        },
        "checkout": {
          "goal": "enviar_pago"
        }
      },
      "triggers": [
        "quiero sacar licencia",
        "quiero licencia",
        "me interesa licencia",
        "quiero licencia b1",
        "quiero licencia a1",
        "quiero empezar"
      ],
      "next_steps": [
        "explicar proceso segun licencia",
        "confirmar datos y agendar asesoria"
      ],
      "hard_rules": [
        "explica el proceso según la licencia antes de pedir datos",
        "cuando quiera inscribirse, pide los datos para agendar la asesoría",
        "no ofrezcas planes ni mensualidades: se paga por licencia"
      ]
    },
    "conversation_flow": {
      "steps": [
        "detect_pain",
        "present_solution",
        "validate_requirements",
        "guide_next_step"
      ],
      "rules": {
        "no_skip_steps": true,
        "guided_process": true
      }
    },
    "progression_rules": {
      "required_flow": [
        "detect_pain",
        "amplify_impact",
        "present_solution",
        "guide_next_step"
      ]
    }
  },
